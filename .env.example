# Any OpenAI-compatible server works (Ollama, vLLM, llama.cpp server, LM Studio).
# Ollama default:
LLM_BACKEND=openai
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_FAST_MODEL=          # optional smaller model for extraction, e.g. qwen2.5:7b-instruct (blank = same as LLM_MODEL)
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=600

# Pipeline
RESUME=1                  # resume an interrupted run of the same idea from its stage checkpoints

MAX_WORKERS=4             # researchers running in parallel
CRITIC_ROUNDS=1           # review-and-redo rounds (0 disables the critic loop)
MAX_EXTRA_SPECIALISTS=2   # extra idea-specific researchers the coordinator may add (0 disables)

# web_search providers, tried in this order: Brave, SearXNG, then the keyless ddgs library (DuckDuckGo).
# Brave: free tier key at https://brave.com/search/api/
BRAVE_API_KEY=
# SearXNG: your instance must have "json" enabled under search.formats in settings.yml
SEARXNG_URL=

# Comma-separated tools to hide from the pipeline (e.g. when no search provider is available)
DISABLED_TOOLS=

# Set to 1 to disable all network tools (sections fall back to labelled estimates)
OFFLINE=0
