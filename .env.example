# Any OpenAI-compatible server works (Ollama, vLLM, llama.cpp server, LM Studio).
# Ollama default:
LLM_BACKEND=openai
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=600

# Agent behaviour
MAX_TOOL_CALLS=6          # tool calls per agent
MAX_WORKERS=4             # agents researching in parallel
CRITIC_ROUNDS=1           # review-and-redo rounds (0 disables the critic loop)
MAX_EXTRA_SPECIALISTS=2   # extra idea-specific agents the coordinator may add (0 disables)

# web_search providers, tried in this order, DuckDuckGo is the keyless fallback.
# Brave: free tier key at https://brave.com/search/api/
BRAVE_API_KEY=
# SearXNG: your instance must have "json" enabled under search.formats in settings.yml
SEARXNG_URL=

# Comma-separated tools to hide from agents (e.g. when no search provider is available)
DISABLED_TOOLS=

# Set to 1 to disable all network tools (agents fall back to labelled estimates)
OFFLINE=0
